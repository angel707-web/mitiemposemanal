<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reportsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="80dp">

            <!-- Title -->
            <TextView
                android:id="@+id/tvReportsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:text="@string/reports_title"
                android:textColor="@color/text_navy"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Empty State: "Aún no hay reportes" (HU-08 Criterio de aceptación 5) -->
            <LinearLayout
                android:id="@+id/layoutNoReports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊"
                    android:textSize="48sp" />

                <TextView
                    android:id="@+id/tvNoReportsMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/no_reports_message"
                    android:textColor="@color/text_navy"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Los reportes se cierran y guardan automáticamente cada domingo a medianoche."
                    android:textColor="@color/text_gray"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Content Layout: when reports exist -->
            <LinearLayout
                android:id="@+id/layoutReportsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Week Selector Label -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/select_week_label"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Week Spinner (HU-08 Criterio de aceptación 2) -->
                <Spinner
                    android:id="@+id/spReportWeeks"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_spinner"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:spinnerMode="dropdown" />

                <!-- Category Percentages Panel for Selected Week -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardReportWeeklyStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:cardBackgroundColor="#F8F9FE"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvReportCardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="RESUMEN DE TIEMPO (168 HORAS)"
                            android:textColor="@color/text_navy"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="6dp"
                            android:background="@color/input_stroke" />

                        <!-- Dynamic container for category stats -->
                        <LinearLayout
                            android:id="@+id/llReportCategoriesContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Events of the Week Header -->
                <TextView
                    android:id="@+id/tvWeekEventsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/week_events_title"
                    android:textColor="@color/text_sub"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Events of Selected Week RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReportEvents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_event" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Right Circular Back Button -->
    <ImageButton
        android:id="@+id/btnBackReports"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_circle_button"
        android:contentDescription="Regresar"
        android:elevation="4dp"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
